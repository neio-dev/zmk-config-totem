//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
#define ZMK_POINTING_DEFAULT_MOVE_VAL 15000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE 0
#define MEDIA  1
#define NAV  2
#define MOUSE  3
#define SLWMOUSE 4
#define SYM 5
#define NUM 6
#define FUN 7
#define LNAV 8
#define RNAV 9
#define NNUM 10

&mt {
    quick-tap-ms = <150>;
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    macros {
        gif: gif {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    behaviors {
        mup: mup {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_Y(-600)>, <&mmv  MOVE_Y(-200)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        
        mdown: mdown {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_Y(600)>, <&mmv  MOVE_Y(200)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

         mright: mright {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_X(600)>, <&mmv  MOVE_X(200)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

         mleft: mleft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_X(-600)>, <&mmv  MOVE_X(-200)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

       mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;  
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
        };
        mtr: mtr {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };
                    // ── tap dances for home row mods (double-tap+hold = repeat key) ─
        td_a: td_a { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtl LEFT_META A>, <&kp A>; };
        td_r: td_r { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtl LCTRL R>,    <&kp R>; };
        td_s: td_s { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtl LALT S>,     <&kp S>; };
        td_t: td_t { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtl LSHFT T>,    <&kp T>; };

        td_n: td_n { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtr RSHFT N>,  <&kp N>; };
        td_e: td_e { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtr LALT E>,   <&kp E>; };
        td_i: td_i { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtr LCTRL I>,  <&kp I>; };
        td_o: td_o { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&mtr LCMD O>,   <&kp O>; };

        // ── tap dances for layer-tap keys (double-tap+hold = repeat tap key) ─
        td_esc:  td_esc  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt MEDIA ESCAPE>,  <&kp ESCAPE>; };
        td_tab:  td_tab  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt MOUSE TAB>,      <&kp TAB>; };
        td_spc:  td_spc  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt NAV SPACE>,       <&kp SPACE>; };
        td_bspc: td_bspc { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt SYM BACKSPACE>,   <&kp BACKSPACE>; };
        td_ret:  td_ret  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt NUM RETURN>,      <&kp RETURN>; };
        td_del:  td_del  { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt FUN DELETE>,      <&kp DELETE>; };

        // ── thumb ESC (left outer thumb, was lt LNAV ESC) ───────────────
        td_lnav: td_lnav { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt LNAV ESC>, <&kp ESC>; };
        td_rnav: td_rnav { compatible = "zmk,behavior-tap-dance"; #binding-cells = <0>; tapping-term-ms = <170>; bindings = <&lt RNAV SINGLE_QUOTE>, <&kp SINGLE_QUOTE>; };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
            &kp Q    &kp W    &kp F    &kp P    &kp G      &kp J     &kp L    &kp U      &kp Y     &kp SEMI
           &td_a    &td_r    &td_s    &td_t    &kp D      &kp H     &td_n    &td_e      &td_i     &td_o
&td_lnav   &kp Z    &kp X  &kp C  &kp V   &kp B      &kp K     &kp M    &kp COMMA  &kp DOT  &kp FSLH  &td_rnav
                             &td_esc  &td_tab  &td_spc    &td_bspc  &td_ret  &td_del
            >;
        };

        medialayer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp R       &kp M             &kp H              &kp S            &kp V
        &trans  &trans  &trans  &trans  &trans    &kp E       &kp K_PREVIOUS    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT
&trans  &trans  &trans  &trans  &trans  &trans    &kp O       &kp N0            &kp N1             &kp N2           &kp N3      &trans
                        &trans  &trans  &trans    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃     UP    ┃           ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃   P UP    ┃  C LOCK   ┃  P DOWN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃    DEL    ┃     0     ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp K_REDO    &kp HOME        &kp PG_DN      &kp PG_UP     &kp END
        &trans  &trans  &trans  &trans  &trans    &kp CAPSLOCK  &kp LEFT        &kp DOWN       &kp UP_ARROW  &kp RIGHT
&trans  &trans  &trans  &trans  &trans  &trans    &kp INSERT    &kp HOME        &kp PG_DN      &kp PAGE_UP   &kp END     &trans
                        &trans  &trans  &trans    &kp ENTER     &kp BACKSPACE   &kp DELETE
            >;
        };

        mouselayer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp K_REDO  &kp LG(C_AC_PASTE)  &kp C_AC_COPY   &kp C_AC_CUT  &kp K_UNDO
        &trans  &trans  &lt SLWMOUSE ESCAPE  &trans  &trans   &trans      &mmv MOVE_X(-600)  &mmv MOVE_Y(600)  &mmv MOVE_Y(-600)  &mmv MOVE_X(600)
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans    &mkp MB1    &mkp MB3            &mkp MB2
            >;
        };

        slowmouselayer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp K_REDO  &kp LG(C_AC_PASTE)  &kp C_AC_COPY   &kp C_AC_CUT  &kp K_UNDO
        &trans  &trans  &trans  &trans  &trans   &trans      &mmv MOVE_X(-200)  &mmv MOVE_Y(200)  &mmv MOVE_Y(-200)  &mmv MOVE_X(200)
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans    &mkp MB1    &mkp MB3            &mkp MB2
            >;
        };

        symlayer {
            bindings = <
        &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTERISK  &kp KP_LPAR  &kp RIGHT_BRACE    &trans  &trans  &trans  &trans  &trans
        &kp BACKSLASH   &kp DOLLAR     &kp PERCENT   &kp CARET    &kp PLUS           &trans  &trans  &trans  &trans  &trans
&trans  &kp TILDE       &kp EXCL       &kp AT        &kp HASH     &kp PIPE           &trans  &trans  &trans  &trans  &trans  &trans
                                       &kp LPAR      &kp RPAR     &kp MINUS          &trans  &trans  &trans
            >;

        };

        numlayer {
            bindings = <
        &kp LEFT_BRACKET  &kp N7  &kp N8   &kp N9  &kp RIGHT_BRACKET    &trans  &trans  &trans  &trans  &trans
        &kp SEMI          &kp N4  &kp N5   &kp N6  &kp EQUAL            &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE         &kp N1  &kp N2   &kp N3        &kp BACKSLASH        &trans  &trans  &trans  &trans  &trans  &trans
                                           &kp KP_DOT  &kp N0        &kp MINUS            &trans  &trans  &trans
            >;
        };

        funlayer {
            bindings = <
        &kp F12  &kp F7  &kp F8              &kp F9     &kp PRINTSCREEN    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
        &kp F11  &kp F4  &kp F5              &kp F6     &kp SCROLLLOCK     &trans      &trans      &trans  &trans  &trans
&trans  &kp F10  &kp F1  &kp F2              &kp F3     &kp PAUSE_BREAK    &trans      &trans      &trans  &trans  &trans  &bt BT_CLR
                         &kp K_CONTEXT_MENU  &kp SPACE  &kp TAB            &trans      &trans      &trans
            >;
        };

        left_nav {
     bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &kp HOME  &kp UP  &kp END  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

    };
        right_nav {
     bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp HOME  &kp UP   &kp END
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
    };
    oldnumlayer {
            bindings = <
        &kp N1  &kp N2  &kp N3   &kp N4  &kp N5            &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
        &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans            &trans  &trans  &trans
            >;
        };

};

};


